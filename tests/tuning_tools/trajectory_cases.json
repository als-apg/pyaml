{
  "schema_version": 1,
  "description": "The frozen trajectory-correction cases. The fork test (test_trajectory.py) reads this file as its expected cases and is the one definition of the goldens; the freeze script reads it by path to build the cases and records its sha256 as sha256_cases in the npz. This file is written once; any change to it is a freeze-side change and requires a new freeze.",
  "conventions": {
    "suite": "Every synthetic case has n_bpm = 16, n_h = n_v = 12 and a causal, decoupled response matrix whose columns are all H correctors then all V correctors; example_sr_tikhonov is the phase-2 writer's real 72/72/72 matrix.",
    "bpm_numbering": "beam_to_bpm counts BPMs from 1: j means BPMs 1..j carry beam and x and y are NaN at every BPM after BPM j. Index arrays stored in the npz are 0-based (index_base = 0).",
    "alpha": "alpha = alpha_rel * ||matrix||_2; both are stored in the npz.",
    "no_reference": "A case whose reference is 'none' stores reference = zeros((2, n_bpm)), which is what MATLAB receives as R0 and what the tool's reference=None means."
  },
  "columns": {
    "name": "case name; the npz key prefix",
    "kind": "parity | inverse | verdict-only | step: which golden assertion checks the case",
    "divergence_planes": "planes checked by the verdict-only or step assertion instead of the parity rule; empty for parity and inverse",
    "reason": "expected Reason name of the tool's correct()",
    "alpha_rel": "Tikhonov alpha relative to ||matrix||_2",
    "n_discard": "number of trailing entries of the full-length spectrum zeroed (SCgetPinv's N); all_discarded uses L = min(2*n_bpm, n_cor) = 24",
    "gain": "gain (SCgetPinv's damping)",
    "n_bpm": "BPMs per plane",
    "n_h": "horizontal correctors",
    "n_v": "vertical correctors",
    "dead": "none | last | mid | real: which corrector columns are exactly zero; last = the last corrector of each plane, mid = one corrector inside each plane, real = whatever the real matrix has",
    "dead_per_plane": "number of zero columns per plane, null for the real matrix",
    "structure": "extra structural features of the matrix; collinear_live_pair = one live column set to c times its neighbour in the same BPM gap (c from the seed), the matrix still causal",
    "beam": "all | to_bpm | x_none: all = every BPM has beam; to_bpm = beam at BPMs 1..beam_to_bpm only (NaN in x and y after it); x_none = x is NaN everywhere, y is finite",
    "beam_to_bpm": "the beam cut j for beam = to_bpm, else null",
    "reference": "none | nan_entries | equal_to_readings | v_only: none = zero reference; nan_entries = readings finite, NaN only in some reference entries; equal_to_readings = reference == (x, y); v_only = the H reference row is zero and the V row is finite and differs from y at every BPM",
    "cond_live": "condition number of the live block, 1e3 by construction (for dead_last_plain, of the live block before the collinear pair); null for example_sr_tikhonov, whose value is computed from the real matrix and lives in the npz only",
    "inputs": "the proposal's beam-and-inputs description, verbatim"
  },
